# ─── Required ─────────────────────────────────────────────────────────────
PORT=4000
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
CLIENT_ORIGIN=http://localhost:5173

# ─── Database ─────────────────────────────────────────────────────────────
# If empty, falls back to local node:sqlite (medshelf.db file).
# For production, use a Neon Postgres connection string:
#   DATABASE_URL=postgres://user:pass@host/db?sslmode=require
DATABASE_URL=

# ─── Sanity (catalog + image CDN) ─────────────────────────────────────────
# Get these from sanity.io after `npx sanity init`
# Without them the backend uses local DB only (no stock decrement on Sanity)
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_WRITE_TOKEN=

# ─── Razorpay (payments) ──────────────────────────────────────────────────
# Get from dashboard.razorpay.com → Settings → API Keys
# Live keys start with "rzp_live_"; test keys with "rzp_test_"
# Empty/contains "mock" = mock mode (orders work end-to-end without real payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Shiprocket (delivery) ────────────────────────────────────────────────
# Sign up at shiprocket.in (free)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary

# ─── Resend (transactional email) ─────────────────────────────────────────
# Sign up at resend.com (3,000 emails/mo free)
RESEND_API_KEY=
EMAIL_FROM=MedShelf <orders@medshelf.in>
EMAIL_ADMIN=admin@medshelf.in

# ─── Sentry (error tracking, optional) ────────────────────────────────────
SENTRY_DSN=
