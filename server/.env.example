# ─── Required ─────────────────────────────────────────────────────────────
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
SITE_URL=https://pammedicalbooks.in

# Phones allowed to log in to /admin (comma-separated, E.164 format).
# Example: ADMIN_PHONES=+919876543210,+919811112222
ADMIN_PHONES=

# ─── Database ─────────────────────────────────────────────────────────────
# If empty, falls back to local node:sqlite (medshelf.db file).
DATABASE_URL=
DB_PATH=./medshelf.db

# ─── Razorpay (payments) ──────────────────────────────────────────────────
# dashboard.razorpay.com → Settings → API Keys
# Live keys start with "rzp_live_"; test keys with "rzp_test_"
# Empty/contains "mock" = mock mode
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Shiprocket (delivery) ────────────────────────────────────────────────
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary

# ─── SMS — MSG91 (OTP + transactional) ───────────────────────────────────
# Sign up at msg91.com. Required: AuthKey, Sender ID, two DLT-approved templates
# (one for OTP with {otp} placeholder, one for generic msgs with {message}).
MSG91_AUTH_KEY=
MSG91_SENDER_ID=PAMMED
MSG91_TEMPLATE_ID_OTP=
MSG91_TEMPLATE_ID_GENERIC=

# ─── WhatsApp Business API (optional, falls back to SMS if missing) ─────
# Either Meta Cloud API directly, or via aggregator (Gupshup/MSG91/AiSensy).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# ─── Sanity (catalog + image CDN, optional) ──────────────────────────────
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_WRITE_TOKEN=

# ─── Sentry (optional) ────────────────────────────────────────────────────
SENTRY_DSN=
