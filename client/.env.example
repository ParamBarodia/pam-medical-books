# Client env vars (Vite reads only VITE_*-prefixed vars)

# Backend API origin — leave EMPTY for local dev (Vite proxies /api and /covers to :4000).
# In production (e.g. Vercel), set to your deployed API origin, no trailing slash:
#   VITE_API_BASE_URL=https://api.pammedicalbooks.in
VITE_API_BASE_URL=

# ─── Sanity ───────────────────────────────────────────────────────────────
# Set these to fetch the catalog from Sanity instead of the local Express API.
# When empty, the app falls back to the local Express endpoints.
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production

# ─── Sentry (optional) ────────────────────────────────────────────────────
VITE_SENTRY_DSN=
