# Client env vars (Vite reads only VITE_*-prefixed vars)

# Backend API base — leave default for local dev (Vite proxy /api → :4000)
VITE_API_URL=

# ─── Sanity ───────────────────────────────────────────────────────────────
# Set these to fetch the catalog from Sanity instead of the local Express API.
# When empty, the app falls back to the local Express endpoints.
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production

# ─── Sentry (optional) ────────────────────────────────────────────────────
VITE_SENTRY_DSN=
